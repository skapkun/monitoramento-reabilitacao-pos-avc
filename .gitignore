# Do NOT commit credentials, keys, or secrets
*.key
*.pem
*.p12
*.pfx
*.keystore
.env
secrets/
config/secrets.json
firebase_key.json
# Os arquivos de configuração cliente do Firebase não são credenciais
# administrativas. Restrinja as chaves no Google Cloud e nunca versione uma
# chave de conta de serviço.

