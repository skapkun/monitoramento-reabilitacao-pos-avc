rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function linkedTherapist(patientId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/careLinks/$(request.auth.uid + '_' + patientId))
        && firestore.get(/databases/(default)/documents/careLinks/$(request.auth.uid + '_' + patientId)).data.status == 'accepted';
    }

    match /sessionVideos/{patientId}/{sessionId}/video {
      allow create: if signedIn()
        && request.auth.uid == patientId
        && request.resource.size <= 100 * 1024 * 1024
        && request.resource.contentType.matches('video/.*')
        && request.resource.metadata.patientId == patientId
        && request.resource.metadata.sessionId == sessionId
        && request.resource.metadata.consentVersion == 'video-sharing-v1'
        && request.resource.metadata.consentAt is string
        && request.resource.metadata.retentionUntil is string;

      allow read: if signedIn()
        && request.time < resource.timeCreated + duration.value(30, 'd')
        && (request.auth.uid == patientId || linkedTherapist(patientId));

      allow delete: if signedIn() && request.auth.uid == patientId;
      allow update: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
